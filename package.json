{
  "name": "@mencoro/mcp",
  "version": "1.0.0",
  "mcpName": "com.mencoro/mencoro",
  "description": "Stdio bridge to the hosted Mencoro MCP server for AI-search (GEO) brand monitoring.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "geo",
    "generative-engine-optimization",
    "ai-search",
    "ai-visibility",
    "share-of-voice",
    "brand-monitoring",
    "rank-tracking",
    "mencoro"
  ],
  "homepage": "https://mencoro.com/features/mcp-server/",
  "bugs": {
    "url": "https://github.com/mencoro/mencoro-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mencoro/mencoro-mcp.git"
  },
  "license": "MIT",
  "author": "Mencoro <support@mencoro.com> (https://mencoro.com)",
  "type": "module",
  "bin": {
    "mencoro-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --build --force",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build",
    "start": "node dist/cli.js",
    "check:manifests": "node scripts/check-manifests.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
